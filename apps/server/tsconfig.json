{
  "extends": ["@tsconfig/node24/tsconfig.json", "../../tsconfig.base.json"],
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "compilerOptions": {
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true
  }
}
